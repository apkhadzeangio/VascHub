# Copy to .env. Generate a separate random value for each secret: openssl rand -hex 32
PAYLOAD_SECRET=
PREVIEW_SECRET=
CRON_SECRET=
# Local app connection. Compose overrides this host with db.
DATABASE_URL=postgresql://vaschub:CHANGE_ME@127.0.0.1:5432/vaschub
POSTGRES_USER=vaschub
POSTGRES_PASSWORD=
POSTGRES_DB=vaschub
# Public origin, without trailing slash. Used at build and runtime.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional local path. Compose uses /app/public/media with a named volume.
MEDIA_DIR=./public/media
# Protected PDFs: must remain outside public/. Back this directory up with the database.
LIBRARY_FILES_DIR=./private/library-files
NEXT_TELEMETRY_DISABLED=1
